    "definitions": {
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 4
                }
            }
        },
        "company.CreateCompanyRequest": {
            "type": "object",
            "required": [
                "code",
                "name"
            ],
            "properties": {
                "address": {
                    "type": "string"
                },
                "city": {
                    "type": "string",
                    "maxLength": 100
                },
                "code": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 2
                },
                "country": {
                    "type": "string",
                    "maxLength": 100
                },
                "description": {
                    "type": "string"
                },
                "email": {
                    "type": "string",
                    "maxLength": 150
                },
                "name": {
                    "type": "string",
                    "maxLength": 150,
                    "minLength": 2
                },
                "phone": {
                    "type": "string",
                    "maxLength": 50
                }
            }
        },
        "company.UpdateCompanyRequest": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "city": {
                    "type": "string",
                    "maxLength": 100
                },
                "code": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 2
                },
                "country": {
                    "type": "string",
                    "maxLength": 100
                },
                "description": {
                    "type": "string"
                },
                "email": {
                    "type": "string",
                    "maxLength": 150
                },
                "isActive": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string",
                    "maxLength": 150,
                    "minLength": 2
                },
                "phone": {
                    "type": "string",
                    "maxLength": 50
                }
            }
        },
        "openapi.ErrorDetail": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "details": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "openapi.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/openapi.ErrorDetail"
                },
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "openapi.SuccessResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string"
                },
                "meta": {},
                "success": {
                    "type": "boolean"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "patients.CreatePatientRequest": {
            "type": "object",
            "required": [
                "nom"
            ],
            "properties": {
                "age": {
                    "type": "integer",
                    "maximum": 130,
                    "minimum": 0
                },
                "dateNaissance": {
                    "type": "string"
                },
                "isAssure": {
                    "type": "boolean"
                },
                "matriculeAssure": {
                    "type": "string",
                    "maxLength": 100
                },
                "nom": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 2
                },
                "personneContact": {
                    "type": "string",
                    "maxLength": 150
                },
                "prenoms": {
                    "type": "string",
                    "maxLength": 150
                },
                "quartier": {
                    "type": "string",
                    "maxLength": 150
                },
                "sexe": {
                    "type": "string",
                    "enum": [
                        "M",
                        "F"
                    ]
                },
                "tauxCouverture": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0
                },
                "telephone": {
                    "type": "string",
                    "maxLength": 30,
                    "minLength": 8
                }
            }
        },
        "patients.UpdatePatientRequest": {
            "type": "object",
            "properties": {
                "age": {
                    "type": "integer"
                },
                "dateNaissance": {
                    "type": "string"
                },
                "isAssure": {
                    "type": "boolean"
                },
                "matriculeAssure": {
                    "type": "string"
                },
                "nom": {
                    "type": "string"
                },
                "personneContact": {
                    "type": "string"
                },
                "prenoms": {
                    "type": "string"
                },
                "quartier": {
                    "type": "string"
                },
                "sexe": {
                    "type": "string"
                },
                "tauxCouverture": {
                    "type": "number"
                },
                "telephone": {
                    "type": "string"
                }
            }
        }
