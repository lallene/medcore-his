APP_ENV=development
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173
# API HTTP hardening (GRC15-B07). Blank -> default. Invalid or out-of-range -> startup failure.
# Go durations (10s, 2m) or byte counts. See docs/GRC_PRODUCTION.md.
# MEDCORE_HTTP_READ_HEADER_TIMEOUT=10s
# MEDCORE_HTTP_READ_TIMEOUT=2m
# MEDCORE_HTTP_WRITE_TIMEOUT=2m
# MEDCORE_HTTP_IDLE_TIMEOUT=2m
# MEDCORE_HTTP_SHUTDOWN_TIMEOUT=25s
# MEDCORE_HTTP_MAX_HEADER_BYTES=65536
# MEDCORE_HTTP_MAX_BODY_BYTES=1048576
# MEDCORE_HTTP_MAX_UPLOAD_BYTES=8388608
# SQL pool, applied by API, workers, migrate and seed. Sum over processes < max_connections.
# MEDCORE_DB_MAX_OPEN_CONNS=10
# MEDCORE_DB_MAX_IDLE_CONNS=5
# MEDCORE_DB_CONN_MAX_LIFETIME=30m
# MEDCORE_DB_CONN_MAX_IDLE_TIME=5m
# Hospital civil calendar ("today", CURRENT_DATE). IANA name. Default UTC if unset.
MEDCORE_BUSINESS_TIMEZONE=UTC
# Scheduling wall-clock / recurrence only. Independent of business timezone.
MEDCORE_TIMEZONE=UTC

# Schema ownership (LOT 26I-3): run migrate BEFORE api / notification-worker.
#   go run ./cmd/migrate
# API and worker do not AutoMigrate or Ensure* indexes at startup.

# Appointment notification EMAIL (default off). API and notification-worker must share this flag.
# API: enables durable EMAIL lifecycle intents only (no Graph credentials required).
# notification-worker: when true, requires all MEDCORE_M365_* values below and registers EMAIL adapter.
# Keep secrets in untracked env / secret manager — never commit real credentials.
#
# MEDCORE_NOTIFICATION_EMAIL_ENABLED=false  => worker registers LOG only (M365 env ignored).
# MEDCORE_NOTIFICATION_EMAIL_ENABLED=true   => worker requires all MEDCORE_M365_* below (fail-closed).
# Do not enable EMAIL on the API while leaving the worker disabled/misconfigured — EMAIL intents stay PENDING.
MEDCORE_NOTIFICATION_EMAIL_ENABLED=false

# LOT27D — automatic PerformedAct producers (default false = safe deploy).
# false: clinical workflows run; configure ProducerMaps via API; check readiness.
# true:  fail-closed producers (missing map rolls back clinical transition).
PERFORMED_ACT_PRODUCERS_ENABLED=false
MEDCORE_M365_TENANT_ID=
MEDCORE_M365_CLIENT_ID=
MEDCORE_M365_CLIENT_SECRET=
MEDCORE_M365_SENDER=

# GRC reminder worker only (cmd/grc-reminder-worker). The API does not start it.
# Do not start it before cmd/migrate has created grc_reminder_intents.
# Missing or invalid Microsoft 365 configuration exits the process; it does not mark reminders delivered.
# Stop the process to pause reminders. There is no feature flag.
# GRC_REMINDER_INTERVAL=1h
# GRC_REMINDER_LEASE=15m
# GRC_REMINDER_EVIDENCE_WINDOW_DAYS=30
# GRC_REMINDER_ACTION_WINDOW_DAYS=30
# GRC_REMINDER_POLICY_WINDOW_DAYS=30

# Worker-only poll interval (Go duration).
# Unset / blank / whitespace-only -> 2s.
# Explicit malformed or non-positive values -> worker startup failure (fail closed).
# NOTIFICATION_WORKER_POLL=2s

# Worker-only health HTTP listen port (stdlib net/http; not Gin).
# Unset / blank / whitespace-only -> 8081.
# Explicit malformed, <=0, or >65535 -> worker startup failure (fail closed).
# Endpoints: GET /healthz (liveness), GET /readyz (DB readiness), GET /metrics (Prometheus; 26I-5A foundation).
# No secrets/PHI in health or metrics responses. Metrics share this port (no separate EXPOSE).
# NOTIFICATION_WORKER_HEALTH_PORT=8081

# Demo seed only (go run ./cmd/seed --demo-full|--demo-scheduling|...). Never in production:
# refused when APP_ENV=production, on a non-allowlisted database or Neon. No default value.
# MEDCORE_ALLOW_DEMO_SEED=1
# MEDCORE_DEMO_SEED_PASSWORD=   # >= 12 characters, never committed
