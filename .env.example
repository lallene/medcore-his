APP_ENV=development
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173
# Hospital civil calendar ("today", CURRENT_DATE). IANA name. Default UTC if unset.
MEDCORE_BUSINESS_TIMEZONE=UTC
# Scheduling wall-clock / recurrence only. Independent of business timezone.
MEDCORE_TIMEZONE=UTC

# Appointment notification EMAIL (default off). API and notification-worker must share this flag.
# API: enables durable EMAIL lifecycle intents only (no Graph credentials required).
# notification-worker: when true, requires all MEDCORE_M365_* values below and registers EMAIL adapter.
# Keep secrets in untracked env / secret manager — never commit real credentials.
MEDCORE_NOTIFICATION_EMAIL_ENABLED=false
MEDCORE_M365_TENANT_ID=
MEDCORE_M365_CLIENT_ID=
MEDCORE_M365_CLIENT_SECRET=
MEDCORE_M365_SENDER=
